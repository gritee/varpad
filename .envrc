# AWS profile this repo expects. Create it with `aws configure sso` (see infra/README.md).
# Loaded automatically by direnv if installed (`direnv allow` once); otherwise run: source .envrc
# Plain shell only (no direnv-specific functions), so direnv stays optional.
export AWS_PROFILE=varpad-admin

# Personal overrides (gitignored), e.g. a different profile name:
#   export AWS_PROFILE=my-varpad
# With direnv, run `direnv reload` after editing it.
if [ -f .envrc.local ]; then . ./.envrc.local; fi
